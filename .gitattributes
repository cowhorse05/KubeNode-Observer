# Keep shell scripts runnable through WSL on Windows checkouts.
*.sh text eol=lf
# Preserve raw experiment bytes and collapse generated captures in PR diffs.
log/experiments/** -text linguist-generated=true
# Context lines in a recorded patch can end with a space; preserve the patch.
log/experiments/**/source.patch -whitespace
log/soak-*/** -text linguist-generated=true
log/soak-*/source.patch -whitespace
log/cpu-validation-*/** -text linguist-generated=true
log/cpu-v2-validation-*/** -text linguist-generated=true
log/*-console.txt -text -whitespace linguist-generated=true
log/kata-*/** -text -whitespace linguist-generated=true
log/m8-*/** -text -whitespace linguist-generated=true
log/guest-*/** -text -whitespace linguist-generated=true
log/m9-*/** -text -whitespace linguist-generated=true
log/m10-*/** -text -whitespace linguist-generated=true
log/m10b-*/** -text -whitespace linguist-generated=true
log/m10c-*/** -text -whitespace linguist-generated=true
log/clockdomain-*/** -text -whitespace linguist-generated=true
log/window-*/** -text -whitespace linguist-generated=true
log/clock-*/** -text -whitespace linguist-generated=true
