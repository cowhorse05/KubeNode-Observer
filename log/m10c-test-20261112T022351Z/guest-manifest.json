{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "annotations": {
          "observer.kubenode.io/guest-probe": "enabled"
        },
        "name": "kno-guest",
        "namespace": "kno-m10c-test"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "env": [
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              }
            ],
            "image": "kubenode-observer/guest-probe:m10c",
            "imagePullPolicy": "Never",
            "name": "probe",
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 18081
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "securityContext": {
              "privileged": true
            }
          },
          {
            "args": [
              "--iterations=1800",
              "--interval=1s"
            ],
            "image": "kubenode-observer/guest-workload:m10c",
            "imagePullPolicy": "Never",
            "name": "workload",
            "resources": {
              "limits": {
                "cpu": "1500m",
                "memory": "64Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            }
          }
        ],
        "restartPolicy": "Never",
        "runtimeClassName": "kno-kata-qemu-guest",
        "shareProcessNamespace": true
      }
    }
  ]
}
