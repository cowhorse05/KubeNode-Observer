{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kno-guest-check",
    "namespace": "kno-guest-test"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "args": [
          "-test.run=TestCPU|TestMapStats|TestRunQLatTaskIdentityKernel",
          "-test.v"
        ],
        "image": "kubenode-observer/guest-kernel-test:dev",
        "imagePullPolicy": "Never",
        "name": "probe",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "privileged": true
        },
        "env": [
          {
            "name": "KNO_BPF_TEST",
            "value": "1"
          }
        ]
      }
    ],
    "restartPolicy": "Never",
    "runtimeClassName": "kno-kata-qemu-guest",
    "shareProcessNamespace": true
  }
}
