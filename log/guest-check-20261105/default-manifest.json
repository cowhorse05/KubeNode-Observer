{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kno-guest-check",
    "namespace": "kno-guest-test"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "args": [
          "--check"
        ],
        "image": "kubenode-observer/guest-probe:dev",
        "imagePullPolicy": "Never",
        "name": "probe",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "privileged": true
        }
      }
    ],
    "restartPolicy": "Never",
    "runtimeClassName": "kno-kata-qemu",
    "shareProcessNamespace": true
  }
}
