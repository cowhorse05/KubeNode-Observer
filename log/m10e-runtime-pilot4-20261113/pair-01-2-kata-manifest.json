{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "namespace": "kno-m10e-test",
    "name": "kno-runtime-benchmark"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "benchmark",
        "image": "kubenode-observer/observer-benchmark:m10e",
        "imagePullPolicy": "Never",
        "args": [
          "--listen=:8080",
          "--work-iterations=64"
        ],
        "readinessProbe": {
          "httpGet": {
            "path": "/healthz",
            "port": 8080
          },
          "periodSeconds": 1
        },
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "128Mi"
          }
        }
      }
    ],
    "runtimeClassName": "kno-kata-qemu"
  }
}
