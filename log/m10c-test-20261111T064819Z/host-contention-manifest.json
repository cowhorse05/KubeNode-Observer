{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kno-m10c-host-contention",
    "namespace": "kno-m10c-test"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "args": [
          "--duration=15m",
          "--workers=4"
        ],
        "image": "kubenode-observer/cpu-contention:dev",
        "imagePullPolicy": "Never",
        "name": "cpu",
        "resources": {
          "limits": {
            "cpu": "2",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "32Mi"
          }
        }
      }
    ],
    "restartPolicy": "Never"
  }
}
