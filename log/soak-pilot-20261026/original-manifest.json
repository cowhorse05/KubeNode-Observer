    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-10-20T11:53:01+08:00",
          "prometheus.io/path": "/metrics",
          "prometheus.io/port": "18080",
          "prometheus.io/scrape": "true"
