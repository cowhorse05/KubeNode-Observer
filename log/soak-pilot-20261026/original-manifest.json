            "hostPath": {
              "path": "/sys/kernel/tracing",
              "type": "Directory"
            },
            "name": "tracefs"
          },
          {
            "hostPath": {
              "path": "/run/containerd/containerd.sock",
              "type": "Socket"
            },
            "name": "containerd-socket"
          },
          {
            "hostPath": {
              "path": "/proc",
              "type": "Directory"
            },
            "name": "host-proc"
